# ── Database ─────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Security ──────────────────────────────────────────────────────────────────
# 32-byte random key for AES-256-GCM encryption of Siigo access keys at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars

# JWT signing secret (change in production)
JWT_SECRET=intexa-arca-secret-change-in-prod

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
# 1. Go to https://portal.azure.com → Azure Active Directory → App registrations → New registration
# 2. Supported account types:
#      "Accounts in this organizational directory only"  → corporate-only (recommended for internal tools)
#      "Accounts in any organizational directory and personal Microsoft accounts" → any MS account
# 3. Redirect URI (Web): http://localhost:8080/api/v1/auth/microsoft/callback
# 4. After registration: Certificates & secrets → New client secret
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_REDIRECT_URI=http://localhost:8080/api/v1/auth/microsoft/callback

# Optional: restrict to your company's Azure AD tenant (corporate emails only).
# Find it in Azure Portal → Azure Active Directory → Overview → Tenant ID.
# Leave empty to accept any Microsoft account.
MS_TENANT_ID=

# ── Siigo ─────────────────────────────────────────────────────────────────────
# Credentials for auto-connect on startup. Leave SIIGO_USERNAME empty to disable.
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
# Shared secret for the daily sync trigger (POST /api/v1/siigo/sync/cron).
# The external scheduler must send it as the X-Cron-Secret header.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the React app. After Microsoft OAuth the backend redirects here with ?token=...
# In production replace with your actual frontend domain.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins.
# Defaults to localhost:5173 and localhost:3000 if unset.
# In production set this to your Vercel frontend URL.
# Example: ALLOWED_ORIGINS=https://intexa-arca.vercel.app
ALLOWED_ORIGINS=
